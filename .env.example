# Required. The INITIAL password for /admin. After you change it inside the admin (header > Password), the new
# one is stored hashed in the data and this value is ignored. If you forget it: see deploy/README.md (recovery).
ADMIN_PASSWORD=change-me-to-something-long
# Required in production: the site's address, e.g. barry.waynehsiao.app (DNS A record must point at the VM).
# Use DOMAIN=localhost to try the production stack on your own computer.
DOMAIN=barry.example.com
# Optional. Signs admin session cookies. If unset, a random one is generated at
# startup (you get logged out whenever the server restarts).
SESSION_SECRET=
# Optional (the Docker image already sets these correctly; leave commented in production).
#PORT=3000
#DATA_DIR=./data
# Name of the backup bucket (printed by deploy/gcp-setup.sh). Used by the nightly backup on the VM.
#BUCKET=my-project-barry-backups
# Optional storage-budget limits (defaults shown).
# Gallery photos (YouTube links don't count) and stored comments (pending + approved).
GALLERY_PHOTO_LIMIT=50
COMMENT_LIMIT=100
# Diary entries.
DIARY_ENTRY_LIMIT=100
